# Pinned target versions and non-secret settings for the air-gapped deployment.
# Values taken from the source stack on 2026-11-17 (release 1.261023.0 / connector 7.261026.0).
# Re-confirm with:  docker compose config --images   (on the source VM)

XTMONE_VERSION=latest
OPENCTI_VERSION=latest
OPENCTI_WORKER_VERSION=latest
ELASTICSEARCH_VERSION=8.19.21
REDIS_VERSION=8.10.1
RABBITMQ_VERSION=4.3-management
SILO_VERSION=latest
PGVECTOR_VERSION=pg17
NGINX_VERSION=stable
XTM_COMPOSER_VERSION=latest

# Compose project name on the source. Volume names are prefixed with it, so it
# MUST stay the same on the target or restore-volumes.sh lands data in volumes
# the stack never mounts.
COMPOSE_PROJECT_NAME=xtm

# Air-gap target
INTERNAL_REGISTRY=registry.internal:5000
OPENCTI_BASE_URL=https://20.244.26.112:8443
OPENCTI_COMPOSE_DIR=/opt/opencti-docker
AZURE_RESOURCE_GROUP=SIMULANIS-IN
AZURE_VM_NAME=Opencti
