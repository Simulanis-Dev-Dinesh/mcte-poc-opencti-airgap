# Pinned target versions and non-secret settings for the air-gapped deployment.
# Source of truth for compose tags. Confirm every line against the running
# Azure stack first:  docker compose config --images

OPENCTI_VERSION=7.x.y            # same version you leave Azure on
ELASTICSEARCH_VERSION=8.x.y      # or OPENSEARCH_VERSION=2.x.y — do not switch engines mid-migration
REDIS_VERSION=7.x.y
RABBITMQ_VERSION=3.x.y
MINIO_VERSION=RELEASE.2025-xx-xxTxx-xx-xxZ
XTM_COMPOSER_VERSION=2.x.y       # set to "none" if running static compose connectors

# Air-gap target
INTERNAL_REGISTRY=registry.internal:5000
OPENCTI_BASE_URL=https://opencti.internal.example
OPENCTI_COMPOSE_DIR=/opt/opencti
AZURE_RESOURCE_GROUP=SIMULANIS-IN
AZURE_VM_NAME=Opencti
