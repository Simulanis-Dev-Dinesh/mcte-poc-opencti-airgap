# OpenCTI environment skeleton. Copy to .env on the host. NEVER commit .env.
# Values below are placeholders — fill them from your secret store.

# --- core ---
OPENCTI_ADMIN_EMAIL=admin@example.com
OPENCTI_ADMIN_PASSWORD=CHANGEME
OPENCTI_ADMIN_TOKEN=CHANGEME-UUID            # uuidgen
OPENCTI_BASE_URL=https://opencti.internal.example
OPENCTI_HEALTHCHECK_ACCESS_KEY=CHANGEME

# OpenCTI 7+: MANDATORY, and must be carried across from the source platform.
# Regenerating it makes previously encrypted secrets unreadable.
APP__ENCRYPTION_KEY=CHANGEME                 # openssl rand -base64 32

# --- elasticsearch / opensearch ---
ELASTIC_MEMORY_SIZE=8G
# --- redis ---
REDIS_PASSWORD=CHANGEME
# --- rabbitmq ---
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=CHANGEME
# --- minio / s3 ---
MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=CHANGEME
# --- smtp ---
SMTP_HOSTNAME=CHANGEME
